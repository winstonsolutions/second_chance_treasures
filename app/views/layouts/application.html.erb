<!-- app/views/layouts/application.html.erb -->
<!DOCTYPE html>
<html>
  <head>
    <title>SecondChance Treasures</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  </head>

  <body>
    <!-- Browser compatibility check -->
    <div id="browser-warning" class="alert alert-warning alert-dismissible fade show d-none" role="alert">
      <div class="container">
        <div class="d-flex align-items-center">
          <i class="fas fa-exclamation-triangle me-3 fs-4"></i>
          <div>
            <strong>Your browser is not supported.</strong>
            <p class="mb-0">Please upgrade your browser to continue using all features of our store.</p>
          </div>
          <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      </div>
    </div>

    <%= render 'layouts/header' %>

    <% if notice %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= notice %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>

    <% if alert %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= alert %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>

    <% if info %>
      <div class="alert alert-info alert-dismissible fade show" role="alert">
        <%= info %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>

    <%= yield %>

    <footer class="bg-light mt-5 py-3">
      <div class="container">
        <div class="row">
          <div class="col-md-6">
            <p>&copy; <%= Date.today.year %> SecondChance Treasures</p>
          </div>
          <div class="col-md-6 text-end">
            <%= link_to "About", about_path, class: "text-decoration-none me-3" %>
            <%= link_to "Contact", contact_path, class: "text-decoration-none" %>
          </div>
        </div>
      </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Browser compatibility script -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Browser detection
        function detectBrowser() {
          const ua = window.navigator.userAgent;
          const msie = ua.indexOf('MSIE ');
          const trident = ua.indexOf('Trident/');
          const edge = ua.indexOf('Edge/');
          const operaOld = ua.indexOf('Opera/');
          const operaMini = ua.indexOf('Opera Mini');

          // Check for outdated browsers
          if (msie > 0 || trident > 0 ||
              (edge > 0 && parseInt(ua.substring(edge + 5, ua.indexOf('.', edge)), 10) < 18) ||
              operaOld > 0 || operaMini > 0) {

            // For completely incompatible browsers, redirect to the browser not supported page
            if (msie > 0 || trident > 0 || operaOld > 0) {
              window.location.href = '<%= browser_not_supported_path %>';
              return;
            }

            // For partially incompatible browsers, show warning
            document.getElementById('browser-warning').classList.remove('d-none');
          }
        }

        detectBrowser();
      });
    </script>
  </body>
</html>