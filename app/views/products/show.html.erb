<!-- app/views/products/show.html.erb -->
<div class="container mt-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Home", root_path %></li>
      <% if @primary_category.present? %>
        <li class="breadcrumb-item"><%= link_to @primary_category.name, products_path(category_id: @primary_category.id) %></li>
      <% end %>
      <li class="breadcrumb-item active" aria-current="page"><%= @product.title %></li>
    </ol>
  </nav>

  <div class="row">
    <div class="col-lg-6 col-md-12 mb-4">
      <!-- Main image display area -->
      <div class="main-image mb-3">
        <% if @product.image.attached? %>
          <%= image_tag @product.image.variant(:medium), class: 'img-fluid main-product-image' %>
        <% elsif @product.images.attached? %>
          <%= image_tag @product.images.first.variant(:medium), class: 'img-fluid main-product-image' %>
        <% else %>
          <div class="no-image text-center p-5 bg-light">
            <span>No Image Available</span>
          </div>
        <% end %>
      </div>

      <!-- Additional image thumbnails area -->
      <% if @product.images.attached? %>
        <div class="thumbnail-images d-flex flex-wrap justify-content-start">
          <% @product.images.each do |image| %>
            <div class="thumbnail-image m-2">
              <%= image_tag image.variant(:thumb), class: 'img-thumbnail', style: 'width: 100px; height: 100px; object-fit: cover;' %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="col-lg-6 col-md-12">
      <h1 class="product-title"><%= @product.title %></h1>
      <p class="lead product-price"><%= number_to_currency(@product.price) %></p>

      <div class="product-details mb-4">
        <p><strong>Condition:</strong> <%= @product.condition %></p>
        <p><strong>SKU:</strong> <%= @product.sku %></p>
        <p><strong>Categories:</strong>
          <%= @product.categories.map(&:name).join(', ') %>
        </p>
      </div>

      <div class="description mb-4">
        <h3>Description</h3>
        <p><%= @product.description %></p>
      </div>

      <% if @product.quantity > 0 %>
        <%= form_tag add_to_cart_path(@product), method: :post, class: 'mb-4' do %>
          <div class="form-group">
            <div class="d-flex align-items-center quantity-selector">
              <label for="quantity" class="me-3">Quantity:</label>
              <%= number_field_tag :quantity, 1, min: 1, max: @product.quantity, class: 'form-control quantity-input mb-3' %>
            </div>
          </div>
          <%= submit_tag 'Add to Cart', class: 'btn btn-primary btn-lg' %>
        <% end %>
      <% else %>
        <p class="text-danger">Out of stock</p>
      <% end %>
    </div>
  </div>
</div>

<% content_for :styles do %>
  <style>
    .main-product-image {
      max-height: 500px;
      width: 100%;
      object-fit: contain;
    }
    .thumbnail-image img:hover {
      cursor: pointer;
      opacity: 0.8;
    }

    /* Responsive styles */
    @media (max-width: 576px) {
      .main-product-image {
        max-height: 300px;
      }

      .product-title {
        font-size: 1.5rem;
        margin-top: 1rem;
      }

      .product-price {
        font-size: 1.2rem;
      }

      .thumbnail-image {
        width: calc(25% - 10px);
      }

      .quantity-selector {
        flex-direction: column;
        align-items: flex-start;
      }

      .quantity-input {
        width: 100% !important;
      }

      .btn-lg {
        width: 100%;
      }
    }

    @media (min-width: 577px) and (max-width: 991px) {
      .thumbnail-image {
        width: calc(20% - 10px);
      }

      .quantity-input {
        width: 50% !important;
      }
    }
  </style>
<% end %>

<% content_for :scripts do %>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Click thumbnails to change main image
      const thumbnails = document.querySelectorAll('.thumbnail-image img');
      const mainImage = document.querySelector('.main-product-image');

      thumbnails.forEach(thumb => {
        thumb.addEventListener('click', function() {
          mainImage.src = this.src.replace('thumb', 'medium');
        });
      });
    });
  </script>
<% end %>