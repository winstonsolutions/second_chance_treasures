<div class="container mt-4">
  <h1 class="mb-4">Shopping Cart</h1>

  <% if @cart_items.any? %>
    <div class="cart-items">
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Price</th>
              <th>Quantity</th>
              <th>Subtotal</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @cart_items.each do |item| %>
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <% if item[:product].image.attached? %>
                      <%= image_tag item[:product].image.variant(:thumb), class: "me-3 cart-item-image" %>
                    <% end %>
                    <div>
                      <h5 class="mb-0 cart-item-title"><%= item[:product].title %></h5>
                      <small class="text-muted">SKU: <%= item[:product].sku %></small>
                    </div>
                  </div>
                </td>
                <td><%= number_to_currency(item[:product].price) %></td>
                <td>
                  <%= form_tag cart_update_path(item[:product]), method: :patch, class: 'd-flex align-items-center' do %>
                    <div class="input-group cart-quantity-input">
                      <%= number_field_tag :quantity,
                          item[:quantity],
                          min: 1,
                          max: item[:product].quantity,
                          class: 'form-control quantity-input' %>
                      <%= submit_tag 'Update', class: 'btn btn-outline-secondary btn-sm update-btn' %>
                    </div>
                  <% end %>
                </td>
                <td><%= number_to_currency(item[:subtotal]) %></td>
                <td>
                  <%= button_to cart_remove_path(item[:product]),
                      method: :delete,
                      class: 'btn btn-danger btn-sm',
                      data: { confirm: 'Are you sure you want to remove this item?' } do %>
                    <i class="bi bi-trash"></i> <span class="d-none d-md-inline">Remove</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="card mt-4">
        <div class="card-body">
          <div class="row">
            <div class="col-md-6 mb-3 mb-md-0">
              <%= link_to products_path, class: 'btn btn-outline-primary w-100 w-md-auto' do %>
                <i class="bi bi-arrow-left"></i> Continue Shopping
              <% end %>
            </div>
            <div class="col-md-6">
              <div class="text-center text-md-end">
                <h4>Total: <%= number_to_currency(@cart_service.total) %></h4>
                <% if user_signed_in? %>
                  <%= button_to orders_path,
                      method: :post,
                      class: 'btn btn-success btn-lg mt-2 w-100 w-md-auto' do %>
                    <i class="bi bi-cart-check"></i> Checkout
                  <% end %>
                <% else %>
                  <div class="card border-info mt-3 mb-3">
                    <div class="card-body">
                      <h5 class="card-title">Checkout Options</h5>
                      <div class="d-grid gap-2">
                        <%= link_to new_user_session_path, class: 'btn btn-outline-primary' do %>
                          <i class="bi bi-person-check"></i> Login to Checkout
                        <% end %>
                        <%= link_to new_user_registration_path, class: 'btn btn-outline-primary' do %>
                          <i class="bi bi-person-plus"></i> Create Account & Checkout
                        <% end %>
                        <%= link_to guest_checkout_path, class: 'btn btn-success' do %>
                          <i class="bi bi-cart-check"></i> Checkout as Guest
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="text-center py-5">
      <i class="bi bi-cart-x icon-large"></i>
      <h3 class="mt-3">Your Cart is Empty</h3>
      <p class="text-muted">Start shopping to add items to your cart!</p>
      <%= link_to products_path, class: 'btn btn-primary mt-3' do %>
        <i class="bi bi-shop"></i> Browse Products
      <% end %>
    </div>
  <% end %>
</div>

<% content_for :styles do %>
  <style>
    @media (max-width: 576px) {
      .cart-items .table {
        font-size: 0.85rem;
      }

      .cart-item-title {
        font-size: 0.9rem;
      }

      .cart-quantity-input {
        width: 100%;
        flex-wrap: wrap;
      }

      .quantity-input {
        width: 100%;
        margin-bottom: 5px;
      }

      .update-btn {
        width: 100%;
      }

      .w-md-auto {
        width: 100%;
      }
    }

    @media (min-width: 768px) {
      .w-md-auto {
        width: auto !important;
      }
    }
  </style>
<% end %>